[node name="PureDoomControls" instance=ExtResource("1_controls")]
script = ExtResource("2_script")
input_catalog = ExtResource("3_catalog")
action_button_0 = &"doom_use"
action_button_1 = &"doom_confirm"
action_button_2 = &"doom_fire"
action_button_3 = &"doom_run"
; The Back button is left blank on purpose: the d-pad's down arm already opens DOOM's menu, and one
; menu button is enough. Start is the host's, not the engine's - it gives the cursor back.
action_button_6 = &"doom_leave"
action_button_11 = &"doom_dpad_up"
action_button_12 = &"doom_dpad_down"
action_button_13 = &"doom_dpad_left"
action_button_14 = &"doom_dpad_right"
action_move_up = &"doom_move_up"
action_move_down = &"doom_move_down"
action_move_left = &"doom_move_left"
action_move_right = &"doom_move_right"
action_look_up = &"doom_look_up"
action_look_down = &"doom_look_down"
action_look_left = &"doom_look_left"
action_look_right = &"doom_look_right"
; The keyboard art is exported so a project that binds different keys than the addon's defaults shows
; its own. These are the keys PureDoom itself answers to, bar the brackets on the weapon arms, which
; are this HUD's own because DOOM has no previous-or-next weapon key. The sticks keep the addon's
; W/A/S/D and arrows, and Start keeps its Escape, because those are already what DOOM wants.
keyboard_mouse_button_0_normal = ExtResource("4_space_normal")
keyboard_mouse_button_0_pressed = ExtResource("5_space_pressed")
keyboard_mouse_button_1_normal = ExtResource("6_enter_normal")
keyboard_mouse_button_1_pressed = ExtResource("7_enter_pressed")
keyboard_mouse_button_2_normal = ExtResource("8_ctrl_normal")
keyboard_mouse_button_2_pressed = ExtResource("9_ctrl_pressed")
keyboard_mouse_button_3_normal = ExtResource("10_shift_normal")
keyboard_mouse_button_3_pressed = ExtResource("11_shift_pressed")
keyboard_mouse_button_11_normal = ExtResource("12_tab_normal")
keyboard_mouse_button_11_pressed = ExtResource("13_tab_pressed")
keyboard_mouse_button_12_normal = ExtResource("14_tilde_normal")
keyboard_mouse_button_12_pressed = ExtResource("15_tilde_pressed")
keyboard_mouse_button_13_normal = ExtResource("16_prev_normal")
keyboard_mouse_button_13_pressed = ExtResource("17_prev_pressed")
keyboard_mouse_button_14_normal = ExtResource("18_next_normal")
keyboard_mouse_button_14_pressed = ExtResource("19_next_pressed")

