# Godot 4+ specific ignores
.godot/
/android/
.DS_Store
test-results/
.mcp/
extension_api.json

# The GDExtension's own build output is ignored by addons/godot_doom_gdextension/.gitignore, which
# travels with the addon so it works the same wherever the addon is dropped.

# Fetched by tools/pull_addons.py, never committed here.
.addon_cache/
addons/controls/

# The web export. Tens of megabytes, and git cannot delta a .wasm; CI builds it for Pages.
build/

# Python bytecode caches from the scripts in tools/
__pycache__/
*.pyc
